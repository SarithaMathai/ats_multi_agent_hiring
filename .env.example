# ── ATS Multi-Agent Hiring System — Environment Variables ─────────────────────
# Copy this file to .env and fill in real values before running.
# Never commit .env to version control.

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
SECRET_KEY=change-this-to-a-long-random-string
LOG_LEVEL=info

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
DATABASE_URL=postgresql+asyncpg://ats_user:ats_password@localhost:5432/ats_db

# ── ChromaDB ──────────────────────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_TOKEN=ats-chroma-token
CHROMA_COLLECTION_CANDIDATES=ats_candidates
CHROMA_COLLECTION_RESUMES=ats_resumes
CHROMA_COLLECTION_FEEDBACK=ats_feedback
CHROMA_COLLECTION_INTERVENTIONS=ats_interventions

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ── Anthropic / LLM ───────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Model tiers (cost-optimised routing)
ANTHROPIC_MODEL_COORDINATOR=claude-opus-4-7          # Orchestrator — highest capability
ANTHROPIC_MODEL_INSIGHT=claude-sonnet-4-6            # Insight agents — balanced
ANTHROPIC_MODEL_SUPPORT=claude-haiku-4-5-20251001    # Routing / Eval — lowest latency

# ── Embeddings ────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── MCP Service (Improvement Action Agent) ────────────────────────────────────
MCP_SERVICE_URL=http://localhost:9000
MCP_SERVICE_TOKEN=your-mcp-token
MCP_TIMEOUT_SECONDS=10

# ── Observability ─────────────────────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=ats-multi-agent-hiring
