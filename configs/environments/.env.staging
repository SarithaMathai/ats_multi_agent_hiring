APP_ENV=staging
APP_PORT=8080
LOG_LEVEL=info

POSTGRES_HOST=staging-postgres
POSTGRES_PORT=5432
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=REPLACE_WITH_STAGING_PASSWORD
DATABASE_URL=postgresql+asyncpg://ats_user:REPLACE_WITH_STAGING_PASSWORD@staging-postgres:5432/ats_db

CHROMA_HOST=staging-chromadb
CHROMA_PORT=8000
CHROMA_TOKEN=REPLACE_WITH_STAGING_TOKEN

REDIS_HOST=staging-redis
REDIS_PORT=6379
REDIS_URL=redis://staging-redis:6379/0

ANTHROPIC_MODEL_COORDINATOR=claude-opus-4-7
ANTHROPIC_MODEL_INSIGHT=claude-sonnet-4-6
ANTHROPIC_MODEL_SUPPORT=claude-haiku-4-5-20251001
