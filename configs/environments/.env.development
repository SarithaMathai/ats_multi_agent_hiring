APP_ENV=development
APP_PORT=8080
LOG_LEVEL=debug

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
DATABASE_URL=postgresql+asyncpg://ats_user:ats_password@localhost:5432/ats_db

CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_TOKEN=ats-chroma-token

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_MODEL_COORDINATOR=claude-sonnet-4-6
ANTHROPIC_MODEL_INSIGHT=claude-sonnet-4-6
ANTHROPIC_MODEL_SUPPORT=claude-haiku-4-5-20251001
