APP_ENV=production
APP_PORT=8080
LOG_LEVEL=warning

# All production values must be injected via secrets manager (AWS Secrets Manager,
# HashiCorp Vault, etc.) — never hardcode production credentials.

POSTGRES_HOST=prod-postgres
POSTGRES_PORT=5432
POSTGRES_DB=ats_db
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=INJECT_FROM_SECRETS_MANAGER
DATABASE_URL=INJECT_FROM_SECRETS_MANAGER

CHROMA_HOST=prod-chromadb
CHROMA_PORT=8000
CHROMA_TOKEN=INJECT_FROM_SECRETS_MANAGER

REDIS_HOST=prod-redis
REDIS_PORT=6379
REDIS_URL=INJECT_FROM_SECRETS_MANAGER

ANTHROPIC_API_KEY=INJECT_FROM_SECRETS_MANAGER
ANTHROPIC_MODEL_COORDINATOR=claude-opus-4-7
ANTHROPIC_MODEL_INSIGHT=claude-sonnet-4-6
ANTHROPIC_MODEL_SUPPORT=claude-haiku-4-5-20251001
