async def run_level4():
    # Step A — run PipelineHealthAgent first
    ph_context = AgentContext(
        query="Where are the biggest bottlenecks in the hiring funnel?",
        run_id="day9-cross",
        structured_data=STRUCTURED_DATA,
        rag_collections=[],
    )
